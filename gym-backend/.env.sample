# Copy this file to .env and fill in the values. Every variable below explains
# what it's for and exactly how to get/generate a real value for it.

NODE_ENV=development
PORT=8004

# --- Database & Redis ---
# Matches the postgres/redis services in gym-entrypoint/docker-compose.yml.
# If you're running Postgres/Redis via that compose file with the default
# ports, you don't need to change these. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://gym:gym@localhost:8001/gym?schema=public
REDIS_URL=redis://localhost:8000

# --- JWT secrets ---
# Any long random string works — these just need to be secret and stable
# (changing them invalidates every issued token). Generate one with:
#   openssl rand -hex 32
# or (no openssl):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two DIFFERENT values for these two — never reuse one secret for both.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Next.js dev falls back to 3001/3002/etc if 3000 is busy, so a few are
# listed. 8003 is the admin frontend (Vite). Add your deployed domains here
# in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:8003

# Requests allowed per IP per 15 minutes (whole API / login, register, OTP and
# password-reset endpoints). Keep the defaults in production.
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Behind a reverse proxy / load balancer (nginx, Render, Railway...), set to the
# number of proxy hops — usually 1 — so rate limits apply per visitor, not
# per proxy. Leave unset when the API is reached directly.
# TRUST_PROXY=1

# --- Email (OTP / password reset) ---
# Optional. Leave SMTP_HOST empty to log OTP/reset emails to the console
# during local dev instead of actually sending them — nothing breaks.
# To send real emails, pick one:
#   - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#     SMTP_PASS=<a 16-char App Password — NOT your normal Gmail password>.
#     Create one at https://myaccount.google.com/apppasswords (requires
#     2-Step Verification to be enabled on the Google account first).
#   - Mailtrap (fake inbox for testing, no real emails sent): sign up free
#     at https://mailtrap.io, create an inbox, and copy the SMTP
#     host/port/user/pass it gives you under Integration > Node.js/SMTP.
#   - Any other provider's SMTP credentials (SendGrid, Postmark, etc.) work
#     the same way — host/port/user/pass from that provider's dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Gym Platform <no-reply@gym.local>

# --- Google Sign-In (OAuth) ---
# Optional. Leave empty to disable "Sign in with Google" (returns 501,
# everything else keeps working). To enable it:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project (or pick an existing one).
#   3. Create Credentials > OAuth client ID > Application type: Web application.
#   4. Add your frontend origin(s) under "Authorized JavaScript origins"
#      (e.g. http://localhost:3000).
#   5. Copy the generated Client ID (ends in .apps.googleusercontent.com)
#      into this variable.
GOOGLE_CLIENT_ID=

# --- Mobile-number sign-in (SMS one-time codes) ---
# Pick ONE provider and fill in its keys. Left empty in development, codes are
# written to the backend log instead ("[sms:stub] to=... code=...").
# In production with nothing set, the mobile option is hidden.
#
# MSG91 (best for India): https://msg91.com → API → Auth key; create an OTP
# template approved on the DLT portal whose text contains the ##otp## variable,
# and paste its template ID.
#   SMS_PROVIDER=msg91
#   MSG91_AUTH_KEY=
#   MSG91_OTP_TEMPLATE_ID=
#
# Twilio: https://console.twilio.com → Account SID + Auth Token, and a Twilio
# phone number (or messaging sender) that can text your country.
#   SMS_PROVIDER=twilio
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_FROM_NUMBER=
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google AI Studio (Gemini) — AI features ---
# Optional. Powers the AI workout/diet plan generator, exercise form tips,
# daily motivation messages, nutrition suggestions, and the AI Coach chatbot.
# Leave empty to disable these gracefully (503 with a clear message,
# everything else keeps working).
# Get a free key:
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with a Google account.
#   3. Click "Create API key" (pick or create a Google Cloud project when
#      prompted — no billing required for the free tier).
#   4. Copy the key into GEMINI_API_KEY below (older keys start with "AIza...",
#      newer ones can start with "AQ." — either works).
# If you see "Quota exceeded ... limit: 0" for a model, that model isn't
# enabled on this key's project — try GEMINI_MODEL=gemini-flash-latest instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Uploads ---
# Base URL used to build absolute links to locally-stored uploaded files
# (profile photos, CMS images, etc). Point this at your real public
# domain/CDN in production instead of switching storage backends.
PUBLIC_URL=http://localhost:8004

# Member web app URL, used for links in emails (password reset).
USER_APP_URL=http://localhost:3000

# --- Web Push (browser notifications) ---
# Optional. Generate a keypair with: npx web-push generate-vapid-keys
# Empty = push subscribe/send endpoints return a clear "not configured" error.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Razorpay (payment gateway) ---
# Optional. Free test-mode keys: sign up at https://dashboard.razorpay.com,
# then Settings > API Keys > Generate Test Key. Empty = membership checkout
# falls back to an instant demo-completion flow (clearly labeled as such).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret from Dashboard > Webhooks > Create webhook, pointed at
# <your public backend URL>/api/v1/webhooks/razorpay, subscribed to at least
# "payment.captured" and "payment.failed". This is the source of truth for
# completing a payment (not just the browser callback) — empty disables the
# endpoint (returns 501) and payment confirmation relies solely on the client.
RAZORPAY_WEBHOOK_SECRET=
