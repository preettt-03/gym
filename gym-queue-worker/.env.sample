# Copy this file to .env and fill in the values.
# This service shares the SAME Postgres/Redis instance as gym-backend — use
# identical values to what's in gym-backend/.env for these two.

NODE_ENV=development

# Must point at the same database gym-backend uses (this worker only reads/
# writes rows gym-backend already created — it doesn't run its own migrations).
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://gym:gym@localhost:8001/gym?schema=public

# Must point at the same Redis instance gym-backend uses — this is how the
# worker's BullMQ jobs and the backend's Socket.IO notifications talk to
# each other (see src/lib/notify.ts / gym-backend's notification-subscriber.ts).
REDIS_URL=redis://localhost:8000
