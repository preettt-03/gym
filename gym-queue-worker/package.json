{
  "name": "gym-queue-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Gym Management Platform — background jobs (BullMQ): workout/membership/mission/diet reminders",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "prisma": "^5.19.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
