# Copy to .env (gitignored). docker compose reads it for build-time values.

# Google Sign-In for the member app. Must be the SAME "Web application"
# OAuth client ID as GOOGLE_CLIENT_ID in gym-backend/.env. Empty hides the button.
# Rebuild the user frontend after changing it:  docker compose up -d --build user-frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
